# Copy to .env and fill in. Never commit the real .env.
# scripts/gen-env.sh generates strong values for the secrets below.

APP_ENV=production
APP_PORT=8080
APP_DOMAIN=i-ship.duckdns.org

# PostgreSQL (container credentials; DATABASE_URL is assembled in docker-compose.yml)
POSTGRES_USER=iship
POSTGRES_DB=iship
POSTGRES_PASSWORD=change-me-hex-only

# Only used when running the API outside Docker:
DATABASE_URL=postgres://iship:iship@localhost:55432/iship?sslmode=disable

# JWT: at least 32 random characters
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h

CORS_ORIGINS=https://i-ship.duckdns.org

# Bootstrap admin, created on startup only if no ADMIN user exists.
ADMIN_EMAIL=admin@i-ship.local
ADMIN_PASSWORD=change-me

LOG_LEVEL=info
IMAGE_TAG=latest
